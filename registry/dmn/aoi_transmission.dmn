        </outputEntry>
        <outputEntry id="_A81957CB-C83A-4D18-9EFD-D3B17192F7D4">
          <text>"高"</text>
        </outputEntry>
      </rule>
      <rule id="cl_r3">
        <inputEntry id="_F339609E-A84F-43E6-8DF4-C2CBB61FD101">
          <text>"含まない"</text>
        </inputEntry>
        <inputEntry id="_C23633A7-D446-4A5E-B716-74A7D26F24A7">
          <text>"含まない"</text>
        </inputEntry>
        <inputEntry id="_93BDF678-F338-4E48-857B-64869867F091">
          <text>"可能"</text>
        </inputEntry>
        <outputEntry id="_628B64BD-7A71-4EC6-B13C-8E5AD8559F28">
          <text>"個人情報"</text>
        </outputEntry>
        <outputEntry id="_4A2D8CF4-B802-46BA-8825-E9A70F91F10B">
          <text>"高"</text>
        </outputEntry>
      </rule>
      <rule id="cl_r4">
        <inputEntry id="_6039E9C1-947F-43DB-9717-8FCD46AAE9FF">
          <text>"含まない"</text>
        </inputEntry>
        <inputEntry id="_978E354D-A6D1-45D4-AFAC-7F0186DB22CB">
          <text>"含まない"</text>
        </inputEntry>
        <inputEntry id="_911BF734-4E13-4632-8632-12203B214865">
          <text>"不可能_院内"</text>
        </inputEntry>
        <outputEntry id="_E3BAF86B-B39B-46D8-9BC7-4BE6FE622B6C">
          <text>"院内共有情報"</text>
        </outputEntry>
        <outputEntry id="_3DD9EF84-DE11-4044-A7CD-F70E591EFA19">
