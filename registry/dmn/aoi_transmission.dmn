          <text>"低"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_transmission" name="送信可否判定">
    <variable id="var_decision_transmission" name="送信可否判定" typeRef="Any" />
    <informationRequirement id="_2A358997-F685-4D60-952A-1B41A1BA60C6">
      <requiredDecision href="#decision_identity" />
    </informationRequirement>
    <informationRequirement id="_E1726AD2-00D2-49A7-A194-878206C28996">
      <requiredDecision href="#decision_classification" />
    </informationRequirement>
    <informationRequirement id="_1645EDCC-ABDB-4CD2-A67B-1706A96D02E5">
      <requiredInput href="#id_contact_consent" />
    </informationRequirement>
    <authorityRequirement id="_A1000000-0000-0000-0000-000000000005">
      <requiredAuthority href="#ks_patient_master" />
    </authorityRequirement>
    <decisionTable id="dt_transmission" hitPolicy="FIRST">
      <input id="in_sensitivity" label="機微度レベル">
        <inputExpression typeRef="string" id="_FB172CE7-8F63-4BF0-997C-BBA7C250F03B">
          <text>情報分類判定.sensitivity</text>
        </inputExpression>
