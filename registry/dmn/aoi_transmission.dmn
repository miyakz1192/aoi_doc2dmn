  <decision id="decision_classification" name="情報分類判定">
    <variable id="var_decision_classification" name="情報分類判定" typeRef="Any" />
    <informationRequirement id="_DF89BD98-3CA6-45B0-979E-4F60230FA9AC">
      <requiredInput href="#id_has_medical" />
    </informationRequirement>
    <informationRequirement id="_E73559E5-D506-4D84-AFAE-9875B46C9BE8">
      <requiredInput href="#id_has_pii" />
    </informationRequirement>
    <informationRequirement id="_3B7A2C10-9E4D-4A6F-8C3B-1F2E5D6A7B81">
      <requiredInput href="#id_identifiable" />
    </informationRequirement>
    <authorityRequirement id="_A1000000-0000-0000-0000-000000000003">
      <requiredAuthority href="#ks_action_request" />
    </authorityRequirement>
    <authorityRequirement id="_A1000000-0000-0000-0000-000000000004">
      <requiredAuthority href="#ks_info_ontology" />
    </authorityRequirement>
    <decisionTable id="dt_classification" hitPolicy="FIRST">
      <input id="in_medical" label="病歴・診療内容を含む">
        <inputExpression typeRef="string" id="_6AC72AF2-A367-43FA-A2A2-6FFC8C8EAEC4">
          <text>has_medical</text>
        </inputExpression>
      </input>
      <input id="in_pii" label="個人識別情報を含む">
        <inputExpression typeRef="string" id="_C5EBE8F7-F9D9-4744-B815-35D05B61867A">
          <text>has_pii</text>
        </inputExpression>
      </input>
      <input id="in_identifiable" label="患者個人を特定可能">
        <inputExpression typeRef="string" id="_96925122-AC87-4D21-ADED-5C5615AE2D84">
          <text>identifiable</text>
        </inputExpression>
      </input>
      <output id="out_class" label="情報分類" name="info_class" typeRef="string" />
      <output id="out_sensitivity" label="機微度レベル" name="sensitivity" typeRef="string" />
      <rule id="cl_r1">
        <inputEntry id="_A04ADF28-C70E-4C2F-8D97-0F31772ED16E">
          <text>"含む"</text>
        </inputEntry>
        <inputEntry id="_FD887748-2AC7-4A68-81FF-E8D6CDB91689">
          <text>-</text>
        </inputEntry>
        <inputEntry id="_FA362942-0CDF-49F3-9BF7-7F26B9AC8328">
          <text>-</text>
        </inputEntry>
        <outputEntry id="_CBA3AB2F-A5B4-49EB-AE54-CEB3CD23DE73">
