        </inputExpression>
      </input>
      <output id="out_decision" label="Decision" name="decision" typeRef="string" />
      <output id="out_reason" label="理由コード" name="reason_code" typeRef="string" />
      <rule id="tr_r1">
        <inputEntry id="_4227BCA6-8B3D-4FFB-BF16-F52AEEE892E7">
          <text>-</text>
        </inputEntry>
