        </outputEntry>
      </rule>
      <rule id="tr_r2">
        <inputEntry id="_FBB51EE9-0708-4414-813C-506E00D2FA2E">
          <text>"最高"</text>
        </inputEntry>
        <inputEntry id="_2B4F1828-0E48-4633-96F3-D25258DF862A">
          <text>"高"</text>
        </inputEntry>
        <inputEntry id="_FDF41189-7E47-4AF4-89D7-8E787EA51B48">
          <text>"同意"</text>
        </inputEntry>
        <outputEntry id="_02BB5C57-218F-4C77-A030-25FD7AE19D53">
