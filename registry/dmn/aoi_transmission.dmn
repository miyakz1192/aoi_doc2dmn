  <decision id="decision_identity" name="本人確認判定">
    <variable id="var_decision_identity" name="本人確認判定" typeRef="Any" />
    <informationRequirement id="_3A92E2CB-671B-4BB3-BFFC-0B454B3DF8FF">
      <requiredInput href="#id_name_match" />
    </informationRequirement>
    <informationRequirement id="_C31E4E16-1F38-49F5-B9B4-1E7CEB43213E">
      <requiredInput href="#id_birth_match" />
    </informationRequirement>
    <informationRequirement id="_3B7A2C10-9E4D-4A6F-8C3B-1F2E5D6A7B80">
