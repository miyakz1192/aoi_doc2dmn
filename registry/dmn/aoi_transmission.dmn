        </outputEntry>
        <outputEntry id="_8ECFF5B7-B3E7-494E-8895-AEDD80592E73">
          <text>"最高"</text>
        </outputEntry>
      </rule>
      <rule id="cl_r2">
        <inputEntry id="_1025F6EA-FDDE-4D9D-AA18-A5A85453E57E">
          <text>"含まない"</text>
        </inputEntry>
        <inputEntry id="_B32946A3-87DC-4D50-9B1D-75664490F9FC">
          <text>"含む"</text>
        </inputEntry>
        <inputEntry id="_31930D35-9636-4DEB-960D-1960EDBA4B47">
          <text>"可能"</text>
        </inputEntry>
        <outputEntry id="_A82A59C1-3707-4FAB-B940-A5D1411988B1">
